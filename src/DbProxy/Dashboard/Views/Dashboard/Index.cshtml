@model DbProxy.Dashboard.Models.DashboardViewModel
@{
    Layout = "_Layout";
}

<div class="header">
    <a href="/dashboard" class="logo">Gate<span class="logo-badge">SQL</span></a>
    <a href="/dashboard" class="nav-link active">Dashboard</a>
    <a href="/dashboard/schema" class="nav-link">Schema</a>
    <div class="spacer"></div>
    <form method="post" action="/dashboard/logout" style="margin:0;">
        <button type="submit" class="logout">Logout</button>
    </form>
</div>

<div class="container" hx-ext="sse" sse-connect="/dashboard/events">
    <div class="stats" sse-swap="stats" hx-swap="innerHTML">
        @await Html.PartialAsync("_Stats", Model)
    </div>

    <div id="session-form-area" style="display: flex; justify-content: center;">
        @if (Model.ActiveSessions.Count == 0)
        {
            @await Html.PartialAsync("_CreateSessionForm")
        }
    </div>

    <div class="section">
        <div class="section-header">
            <h2>Sessions</h2>
            <button class="btn-new-session"
                    hx-get="/dashboard/sessions/new"
                    hx-target="#session-form-area"
                    hx-swap="innerHTML">+ New Session</button>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Agent</th>
                    <th>Task</th>
                    <th>Status</th>
                    <th>Queries</th>
                    <th>Hard Cap</th>
                    <th>Idle Timeout</th>
                    <th>Created</th>
                    <th>Session ID</th>
                    <th></th>
                </tr>
            </thead>
            <tbody sse-swap="sessions" hx-swap="innerHTML">
                @await Html.PartialAsync("_SessionsTable", Model)
            </tbody>
        </table>
    </div>

    <div class="section">
        <h2>Recent Queries</h2>
        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Agent</th>
                    <th>Query</th>
                    <th>Context</th>
                    <th>Rows</th>
                    <th>Duration</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="queries" sse-swap="query" hx-swap="afterbegin">
                @foreach (var q in Model.RecentQueries)
                {
                    @await Html.PartialAsync("_QueryRow", q)
                }
            </tbody>
        </table>
    </div>
</div>
