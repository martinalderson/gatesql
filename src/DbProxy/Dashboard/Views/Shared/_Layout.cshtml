<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GateSQL Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f8fafc;
            --bg-card: #ffffff;
            --bg-elevated: #f1f5f9;
            --bg-hover: #e2e8f0;
            --fg: #0f172a;
            --fg-muted: #64748b;
            --fg-dim: #94a3b8;
            --accent: #16a34a;
            --accent-hover: #15803d;
            --red: #dc2626;
            --amber: #d97706;
            --border: rgba(0,0,0,0.08);
            --border-strong: rgba(0,0,0,0.13);
            --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --mono: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: var(--sans); background: var(--bg); color: var(--fg); -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }

        /* Header */
        .header { padding: 0 32px; height: 56px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 16px; background: rgba(248,250,252,0.85); backdrop-filter: blur(16px); position: sticky; top: 0; z-index: 40; }
        .header .logo { font-family: var(--sans); font-weight: 700; font-size: 18px; letter-spacing: -0.02em; color: var(--fg); display: flex; align-items: center; text-decoration: none; }
        .header .logo-badge { background: var(--fg); color: var(--bg); padding: 2px 7px; border-radius: 5px; margin-left: 2px; font-size: 18px; }
        .header .nav-link { font-size: 14px; color: var(--fg-muted); transition: color 0.15s; }
        .header .nav-link:hover { color: var(--fg); }
        .header .nav-link.active { color: var(--fg); font-weight: 500; }
        .header .spacer { flex: 1; }
        .header .logout { font-size: 13px; color: var(--fg-muted); background: none; border: 1px solid var(--border-strong); padding: 5px 14px; border-radius: 8px; cursor: pointer; transition: all 0.15s; }
        .header .logout:hover { color: var(--fg); background: var(--bg-elevated); }

        /* Layout */
        .container { max-width: 1200px; margin: 0 auto; padding: 32px; }
        .section { margin-bottom: 40px; }
        .section h2 { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--fg-muted); margin-bottom: 16px; }

        /* Tables */
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { text-align: left; padding: 8px 12px; color: var(--fg-muted); font-weight: 500; border-bottom: 1px solid var(--border-strong); }
        td { padding: 8px 12px; border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums; }
        tr:hover td { background: var(--bg-elevated); }

        /* Badges — pill style */
        .badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; letter-spacing: 0.02em; }
        .badge-green { background: #dcfce7; color: #166534; }
        .badge-red { background: #fef2f2; color: #991b1b; }
        .badge-yellow { background: #fef9c3; color: #854d0e; }
        .badge-gray { background: #f1f5f9; color: #475569; }

        /* Stats */
        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 32px; }
        .stat-card { background: var(--bg-card); border: 1px solid var(--border-strong); border-radius: 10px; padding: 16px; }
        .stat-card .label { font-size: 12px; color: var(--fg-muted); margin-bottom: 4px; }
        .stat-card .value { font-size: 24px; font-weight: 600; font-variant-numeric: tabular-nums; }

        /* Query text */
        .query-text { max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--mono); font-size: 12px; color: var(--fg-muted); }
        .empty { padding: 32px; text-align: center; color: var(--fg-dim); font-size: 13px; }

        /* Forms */
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 12px; color: var(--fg-muted); margin-bottom: 4px; }
        .form-group input, .form-group select, .form-group textarea { width: 100%; background: var(--bg-card); border: 1px solid var(--border-strong); color: var(--fg); padding: 10px 12px; border-radius: 8px; font-size: 14px; font-family: inherit; transition: border-color 0.15s, box-shadow 0.15s; }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(22,163,74,0.1); }
        .form-group select { appearance: none; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .form-actions { display: flex; gap: 12px; margin-top: 20px; }

        /* Buttons */
        .btn-primary { background: var(--accent); color: #fff; border: none; padding: 10px 24px; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; transition: background 0.15s; }
        .btn-primary:hover { background: var(--accent-hover); }
        .btn-secondary { background: transparent; color: var(--fg); border: 1px solid var(--border-strong); padding: 10px 24px; border-radius: 8px; font-size: 14px; cursor: pointer; transition: all 0.15s; }
        .btn-secondary:hover { background: var(--bg-elevated); }
        .btn-new-session { background: var(--accent); color: #fff; border: none; padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 500; cursor: pointer; transition: background 0.15s; }
        .btn-new-session:hover { background: var(--accent-hover); }
        .btn-revoke { background: #fef2f2; color: #991b1b; border: 1px solid rgba(220,38,38,0.2); padding: 4px 12px; border-radius: 8px; font-size: 11px; font-weight: 500; cursor: pointer; transition: all 0.15s; }
        .btn-revoke:hover { background: #fee2e2; }
        .btn-copy { background: var(--bg-elevated); border: 1px solid var(--border-strong); color: var(--fg-muted); padding: 4px 10px; border-radius: 6px; font-size: 11px; cursor: pointer; white-space: nowrap; flex-shrink: 0; transition: all 0.15s; }
        .btn-copy:hover { color: var(--fg); background: var(--bg-hover); }

        /* Section header with button */
        .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
        .section-header h2 { margin-bottom: 0; }

        /* Session form */
        .session-form { background: var(--bg-card); border: 1px solid var(--border-strong); border-radius: 10px; padding: 24px; max-width: 560px; margin-bottom: 32px; }
        .session-form h3 { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
        .form-subtitle { font-size: 13px; color: var(--fg-muted); margin-bottom: 20px; }
        label.toggle-label { display: flex !important; align-items: center; gap: 8px; cursor: pointer; font-size: 13px !important; color: var(--fg) !important; margin-bottom: 0 !important; }
        label.toggle-label input[type="checkbox"] { accent-color: var(--accent); width: 16px; height: 16px; margin: 0; }

        /* Credential card */
        .credential-card { background: var(--bg-card); border: 1px solid rgba(22,163,74,0.3); border-radius: 10px; padding: 24px; max-width: 560px; margin-bottom: 32px; }
        .credential-header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
        .credential-session-id { font-family: var(--mono); font-size: 12px; color: var(--fg-dim); }
        .credential-row { margin-bottom: 16px; }
        .credential-row label { display: block; font-size: 11px; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
        .credential-value { display: flex; align-items: flex-start; gap: 8px; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
        .credential-value code { font-family: var(--mono); font-size: 12px; color: var(--fg); flex: 1; word-break: break-all; line-height: 1.5; }

        /* Login */
        .login-container { max-width: 360px; margin: 120px auto; padding: 32px; }
        .login-container h1 { font-size: 20px; font-weight: 600; margin-bottom: 8px; }
        .login-container p { font-size: 13px; color: var(--fg-muted); margin-bottom: 24px; }
        .login-container input { width: 100%; background: var(--bg-card); border: 1px solid var(--border-strong); color: var(--fg); padding: 10px 12px; border-radius: 8px; font-size: 14px; font-family: var(--mono); margin-bottom: 12px; }
        .login-container input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(22,163,74,0.1); }
        .login-container button { width: 100%; background: var(--accent); color: #fff; border: none; padding: 10px; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; transition: background 0.15s; }
        .login-container button:hover { background: var(--accent-hover); }
        .login-container .error { color: var(--red); font-size: 13px; margin-bottom: 12px; }

        /* Schema page */
        .schema-container { max-width: 900px; margin: 0 auto; padding: 32px; }
        .schema-intro { margin-bottom: 32px; }
        .schema-intro h1 { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
        .schema-intro > p { font-size: 13px; color: var(--fg-muted); margin-bottom: 16px; }
        .schema-api-hint { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        .schema-api-hint code { font-family: var(--mono); font-size: 12px; color: var(--fg); background: var(--bg-card); padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border); }
        .schema-api-hint span { font-size: 12px; color: var(--fg-muted); }
        .schema-error { background: #fef2f2; border: 1px solid rgba(220,38,38,0.2); border-radius: 8px; padding: 16px; color: #991b1b; font-size: 13px; margin-bottom: 24px; }
        details.table-card { background: var(--bg-card); border: 1px solid var(--border-strong); border-radius: 10px; margin-bottom: 12px; }
        details.table-card summary { padding: 14px 20px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 14px; list-style: none; }
        details.table-card summary::-webkit-details-marker { display: none; }
        details.table-card summary::before { content: '\25B6'; font-size: 9px; color: var(--fg-dim); transition: transform 0.15s; }
        details.table-card[open] summary::before { transform: rotate(90deg); }
        details.table-card summary strong { font-weight: 600; }
        .table-meta { font-size: 12px; color: var(--fg-dim); }
        .table-card-body { padding: 0 20px 20px; }
        .columns-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 16px; }
        .columns-table th { text-align: left; padding: 4px 8px; color: var(--fg-muted); font-weight: 500; border-bottom: 1px solid var(--border-strong); }
        .columns-table td { padding: 4px 8px; border-bottom: 1px solid var(--border); font-family: var(--mono); font-size: 11px; }
        .annotation-form { border-top: 1px solid var(--border); padding-top: 16px; }
        .annotation-form textarea { resize: vertical; min-height: 48px; }
    </style>
    <script src="/htmx.min.js"></script>
    <script src="/sse.js"></script>
</head>
<body>
    @RenderBody()
</body>
</html>
