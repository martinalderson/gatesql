# Stage 1: GateSQL proxy binary
FROM gatesql/gatesql:latest AS gatesql

# Stage 2: OpenCode from npm (Debian builder = glibc, matches final image)
FROM node:22-slim AS opencode-builder
RUN npm install -g opencode-ai@1.3.2

# Stage 3: Final image
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql curl jq && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/keys /app/logs /app/data /var/lib/postgresql/data /var/log /workspace && \
    chown postgres:postgres /var/lib/postgresql/data && \
    touch /var/log/postgresql.log && chown postgres:postgres /var/log/postgresql.log

# GateSQL proxy
COPY --from=gatesql /app .

# OpenCode: copy the native binary directly, bypassing the npm shim's platform detection
COPY --from=opencode-builder /usr/local/lib/node_modules/opencode-ai/bin/.opencode /usr/local/bin/opencode

# Demo assets
COPY demo/demo-config.json /app/config.json
COPY demo/demo-store.sql /app/demo-store.sql
COPY demo/opencode-demo-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV GATESQL_DEMO=true
WORKDIR /workspace

EXPOSE 15432 8080

ENTRYPOINT ["/app/entrypoint.sh"]
