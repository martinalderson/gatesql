FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY DbProxy.slnx .
COPY src/DbProxy/DbProxy.csproj src/DbProxy/
RUN dotnet restore src/DbProxy/DbProxy.csproj

COPY src/ src/
RUN dotnet publish src/DbProxy/DbProxy.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app

# Install PostgreSQL
RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql && \
    rm -rf /var/lib/apt/lists/*

# Create directories
RUN mkdir -p /app/keys /app/logs /app/data /var/lib/postgresql/data /var/log && \
    chown postgres:postgres /var/lib/postgresql/data

# Copy GateSQL build
COPY --from=build /app/publish .
COPY demo/demo-config.json /app/config.json
COPY demo/demo-store.sql /app/demo-store.sql
COPY demo/demo-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 15432 8080

ENTRYPOINT ["/app/entrypoint.sh"]
